{
  "name": "ai-tech-themed-portfolios",
  "version": "2.0.0",
  "description": "Production-ready AI/Tech themed portfolio websites",
  "main": "server.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "install:all": "npm install && cd GLASSMORPHISM-NEURAL-NETWORKS && npm install && cd ../NEON-CYBER-GRID && npm install && cd ../TERMINAL-CLI && npm install && cd ..",
    "dev:all": "npm run dev:glass & npm run dev:neon & npm run dev:terminal",
    "dev:glass": "cd GLASSMORPHISM-NEURAL-NETWORKS && npm run dev",
    "dev:neon": "cd NEON-CYBER-GRID && npm run dev",
    "dev:terminal": "cd TERMINAL-CLI && npm run dev",
    "start:all": "npm run start:glass & npm run start:neon & npm run start:terminal",
    "start:glass": "cd GLASSMORPHISM-NEURAL-NETWORKS && npm start",
    "start:neon": "cd NEON-CYBER-GRID && npm start",
    "start:terminal": "cd TERMINAL-CLI && npm start",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint . --ignore-pattern node_modules",
    "lint:fix": "eslint . --fix --ignore-pattern node_modules",
    "format": "prettier --write .",
    "security": "snyk test",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop all",
    "pm2:restart": "pm2 restart all",
    "pm2:logs": "pm2 logs",
    "pm2:delete": "pm2 delete all",
    "backup": "bash scripts/backup.sh",
    "deploy": "bash scripts/deploy.sh"
  },
  "keywords": [
    "portfolio",
    "ai",
    "tech",
    "glassmorphism",
    "neon",
    "terminal",
    "production"
  ],
  "author": "QMS85",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/QMS85/My-AI-Tech-Themed-Portfolios.git"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "eslint": "^8.50.0",
    "prettier": "^3.0.0",
    "@types/node": "^20.9.0",
    "snyk": "^1.1257.0"
  }
}
