{
  "name": "ai-tech-themed-portfolios",
  "version": "1.0.0",
  "description": "AI/Tech themed portfolio websites with 3 unique designs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "security": "snyk test",
    "build": "echo 'Build complete'",
    "deploy:github": "gh-pages -d public",
    "deploy:vercel": "vercel",
    "deploy:netlify": "netlify deploy",
    "docker:build": "docker build -t jonathan-portfolio:latest .",
    "docker:run": "docker run -p 3000:3000 jonathan-portfolio:latest",
    "docker:compose": "docker-compose up -d"
  },
  "keywords": [
    "portfolio",
    "ai",
    "tech",
    "glassmorphism",
    "neon",
    "terminal"
  ],
  "author": "Jonathan Peters",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "mongoose": "^7.0.0",
    "bcrypt": "^5.1.0",
    "jsonwebtoken": "^9.0.0",
    "validator": "^13.9.0",
    "express-rate-limit": "^6.7.0",
    "mongo-sanitize": "^2.2.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.20",
    "jest": "^29.5.0",
    "eslint": "^8.40.0",
    "snyk": "^1.1200.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
